# FarmDirect AI - environment template
# Copy to .env at the repo root:  cp .env.example .env
# The server reads .env (NOT .env.local) via the loader in server/aiIntentApi.mjs
# and server/firebase.mjs. Restart the dev server after any change.

# ---------------------------------------------------------------------------
# 1. AI / LLM  (required for real intent parsing; without it the API runs in
#    FALLBACK mode = local regex parsing only, no AI)
# ---------------------------------------------------------------------------
# OpenRouter: https://openrouter.ai/keys  (key looks like sk-or-v1-...)
AI_API_KEY=
# Any OpenRouter model slug: https://openrouter.ai/models
# Defaults to openai/gpt-4o-mini if left blank.
AI_API_MODEL=openai/gpt-4o-mini
# Default: https://openrouter.ai/api/v1
# Any OpenAI-compatible endpoint works (e.g. https://api.openai.com/v1,
# https://api.groq.com/openai/v1) - then AI_API_KEY must be that provider's key.
AI_API_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# 2. Firebase ADMIN (server-side: Firestore reads/writes, listings, orders)
# ---------------------------------------------------------------------------
# Firebase Console > Project settings > Service accounts >
#   "Generate new private key" -> saves a JSON file.
# Put that file OUTSIDE the repo (or add it to .gitignore) and point here.
# Absolute path, or relative to the repo root.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ---------------------------------------------------------------------------
# 3. Firebase CLIENT config (browser auth: phone OTP, sign-in)
#    Without it the app falls back to an in-memory simulated auth provider.
#    Firebase Console > Project settings > General > Your apps > Web app > Config
#    Paste the config object as ONE LINE of JSON.
# ---------------------------------------------------------------------------
FIREBASE_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":""}
# Optional: same JSON, baked into the frontend bundle at build time.
# Only needed if the frontend can't reach the API to fetch the config.
# VITE_FIREBASE_CONFIG=

# ---------------------------------------------------------------------------
# 4. Delhivery logistics  (optional - logistics endpoints return
#    "not configured" until DELHIVERY_API_KEY is set)
# ---------------------------------------------------------------------------
# Get the API token from your Delhivery One panel:
#   Settings > API Setup / API Token  (or ask your Delhivery account manager).
# Staging and production tokens are DIFFERENT - they are not interchangeable.
DELHIVERY_API_KEY=
# staging | production   (staging also accepts "test"). Default: production
DELHIVERY_ENV=staging
# Leave blank to pick the URL automatically from DELHIVERY_ENV.
DELHIVERY_BASE_URL=
# Client/warehouse name EXACTLY as registered in the Delhivery panel.
DELHIVERY_CLIENT_NAME=
# Pickup location registered with Delhivery (must match the panel entry).
DELHIVERY_PICKUP_NAME=
DELHIVERY_PICKUP_PHONE=
DELHIVERY_PICKUP_ADDRESS=
DELHIVERY_PICKUP_CITY=
DELHIVERY_PICKUP_STATE=
DELHIVERY_PICKUP_PIN=
# Your GSTIN (from the GST portal) and the produce HSN code
# (fresh vegetables/fruits are usually 0701-0810; check your CA).
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_HSN_CODE=
# Request timeout in ms. Default: see DEFAULT_TIMEOUT_MS in delhiveryService.mjs
DELHIVERY_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# 5. Local wiring (all have working defaults - only change if ports clash)
# ---------------------------------------------------------------------------
# Standalone API port (npm run dev:ai). Default: 8787
AI_INTENT_PORT=8787
# CORS origin. Blank = any localhost origin is allowed.
AI_ALLOWED_ORIGIN=
# Where conversationManager fetches listings from.
# Default: http://localhost:3000/api/listings
LISTINGS_API_URL=http://localhost:3000/api/listings

# ---------------------------------------------------------------------------
# 6. Twilio voice  (optional - only for phone-call ordering)
#    No credentials needed: server/twilioVoice.mjs only RECEIVES webhooks, it
#    never calls the Twilio REST API, so there is no Account SID / Auth Token.
#
#    In the Twilio console (Phone Numbers > your number > Voice Configuration)
#    set "A call comes in" to:
#      POST https://<your-public-host>/api/twilio/incoming
#    The follow-up callback URL is derived automatically from the host Twilio
#    used to reach you, so ngrok/cloudflared/Vercel need no configuration here.
#
#    Set PUBLIC_BASE_URL only to override that - e.g. a proxy whose forwarded
#    headers do not reflect the host Twilio actually dialled. No trailing slash.
# PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.dev
#
#    Local testing:  ngrok http 3000   (then use that https host in the console)

# FarmDirect AI — Environment Variables for Local Development & Production
# 
# 1. Copy this file to .env and fill in actual values.
# 2. Real secrets (AI_API_KEY, Firebase credentials) must NEVER be committed.
# 3. Production values are configured via the platform dashboard (Vercel, etc.)
#
#   ⚠️ Never edit .env directly in production — use platform env settings.
#   📁 .env files are gitignored; .env.example is committed as reference only.

# =====================
# OpenRouter AI Service
# =====================
# API key for OpenRouter — obtain from https://openrouter.ai
# For production, set this in the Vercel Dashboard > Settings > Environment Variables
AI_API_KEY=your-openrouter-api-key-here

# OpenRouter model endpoint (default: openai/gpt-4o-mini)
AI_API_MODEL=openai/gpt-4o-mini

# OpenRouter base URL
AI_API_BASE_URL=https://openrouter.ai/api/v1

# Local development port for the AI intent API
AI_INTENT_PORT=8787

# =====================
# CORS & Frontend
# =====================
# Comma-separated allowed origins for cross-origin requests
# For Vercel deployment, set to: https://your-app.vercel.app
# For localhost dev, keep "*" or set your dev URL: http://localhost:5173,https://localhost:5173
AI_ALLOWED_ORIGIN=*

# =====================
# Firebase / Firestore
# =====================
# Path to Firebase Admin SDK service account JSON
# For local dev, point to your service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# For production serverless: set FIREBASE_SERVICE_ACCOUNT_JSON to the full JSON content
# (single-line string) in the platform environment variables.
# Overrides FIREBASE_SERVICE_ACCOUNT_PATH when both are present.
FIREBASE_SERVICE_ACCOUNT_JSON=

# =====================
# Optional: Internal listings endpoint (used by voice-agent submission)
# =====================
LISTINGS_API_URL=http://localhost:8787/api/listings

# =====================
# Optional: Redis (if used)
# =====================
# REDIS_URL=redis://localhost:6379

# =====================
# Optional: Additional AI config
# =====================