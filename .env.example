AI_API_KEY=your_api_key_here
AI_API_MODEL=openai/gpt-4o-mini
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_INTENT_PORT=8787
AI_ALLOWED_ORIGIN=*
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/serviceAccountKey.json
FIREBASE_CONFIG=
LISTINGS_API_URL=

# --- Delhivery logistics (server-side only; never expose to the client) ---
# API token from the Delhivery client panel. Keep it secret; never prefix with VITE_.
DELHIVERY_API_KEY=
# "staging" targets https://staging-express.delhivery.com, anything else targets production.
DELHIVERY_ENV=staging
# Optional explicit override of the API base URL (used for local testing).
DELHIVERY_BASE_URL=
# Client name as registered with Delhivery (required by the bulk waybill API).
DELHIVERY_CLIENT_NAME=
# Default pickup warehouse. DELHIVERY_PICKUP_NAME must match the warehouse
# registered with Delhivery exactly, including case.
DELHIVERY_PICKUP_NAME=
DELHIVERY_PICKUP_PHONE=
DELHIVERY_PICKUP_ADDRESS=
DELHIVERY_PICKUP_CITY=
DELHIVERY_PICKUP_STATE=
DELHIVERY_PICKUP_PIN=
# Mandatory on Delhivery's order creation API.
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_HSN_CODE=
# Outbound request timeout in ms (default 15000; stays under the 30s Vercel limit).
DELHIVERY_TIMEOUT_MS=15000
